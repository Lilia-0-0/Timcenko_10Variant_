<Page x:Class="Timcenko_10Variant.Pages.Task4Page"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Задача 4">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap" FontSize="16" Margin="0,0,0,20">
            <Run Text="Задача 4:" FontWeight="Bold"/>
            <Run Text=" Поменять местами первое простое и первое совершенное числа в массиве."/>
        </TextBlock>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Размер массива N: " VerticalAlignment="Center" Width="220"/>
            <TextBox x:Name="txtSize" Width="100" Height="30" VerticalContentAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Элементы через пробел: " VerticalAlignment="Center" Width="220"/>
            <TextBox x:Name="txtArray" Width="400" Height="30" VerticalContentAlignment="Center"/>
        </StackPanel>

        <Button Grid.Row="3" x:Name="btnCalculate" Content="Выполнить расчет"
                Width="200" Height="40" HorizontalAlignment="Left" Click="btnCalculate_Click"/>

        <StackPanel Grid.Row="4" Margin="0,15,0,0">
            <TextBlock Text="Исходный массив:" Margin="0,0,0,5"/>
            <TextBox x:Name="txtOriginal" Height="30" IsReadOnly="True" Background="#F0F0F0"/>
        </StackPanel>

        <StackPanel Grid.Row="5" Margin="0,10,0,0">
            <TextBlock Text="Результат:" Margin="0,0,0,5"/>
            <TextBox x:Name="txtResult" Height="30" IsReadOnly="True" Background="#F0F0F0"/>
        </StackPanel>
    </Grid>
</Page>