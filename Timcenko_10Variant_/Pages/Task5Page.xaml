<Page x:Class="Timcenko_10Variant.Pages.Task5Page"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Задача 5">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap" FontSize="14" Margin="0,0,0,10">
            <Run Text="Задача 5:" FontWeight="Bold"/>
            <Run Text=" Сгенерировать M×N (числа от -10 до 10). Отсортировать по возрастанию и убыванию. Найти max и min."/>
        </TextBlock>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Строк M:" VerticalAlignment="Center"/>
            <TextBox x:Name="txtRows" Width="50" Height="28" Margin="5,0,15,0" VerticalContentAlignment="Center"/>
            <TextBlock Text="Столбцов N:" VerticalAlignment="Center"/>
            <TextBox x:Name="txtCols" Width="50" Height="28" Margin="5,0,15,0" VerticalContentAlignment="Center"/>
            <Button x:Name="btnGenerate" Content="Сгенерировать" Width="140" Height="28" Click="btnGenerate_Click"/>
            <Button x:Name="btnSort" Content="Сортировать" Width="140" Height="28" Margin="10,0,0,0" Click="btnSort_Click"/>
        </StackPanel>

        <TextBlock Grid.Row="2" x:Name="txtInfo" FontSize="14" Margin="0,0,0,10"/>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,5,0">
                <TextBlock Text="Исходный:" FontWeight="Bold"/>
                <DataGrid x:Name="dgOriginal" Height="220" AutoGenerateColumns="True" IsReadOnly="True"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Margin="5,0,5,0">
                <TextBlock Text="По возрастанию:" FontWeight="Bold"/>
                <DataGrid x:Name="dgAsc" Height="220" AutoGenerateColumns="True" IsReadOnly="True"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Margin="5,0,0,0">
                <TextBlock Text="По убыванию:" FontWeight="Bold"/>
                <DataGrid x:Name="dgDesc" Height="220" AutoGenerateColumns="True" IsReadOnly="True"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>