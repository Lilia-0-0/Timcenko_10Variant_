<Page x:Class="Timcenko_10Variant.Pages.Task1Page"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Задача 1">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap" FontSize="16" Margin="0,0,0,20">
            <Run Text="Задача 1:" FontWeight="Bold"/>
            <Run Text=" Дано число. Вывести цифры, которые повторяются в записи числа больше одного раза."/>
        </TextBlock>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">
            <TextBlock Text="Введите число: " VerticalAlignment="Center" Width="150"/>
            <TextBox x:Name="txtInput" Width="300" Height="30" VerticalContentAlignment="Center"/>
        </StackPanel>

        <Button Grid.Row="2" x:Name="btnCalculate" Content="Выполнить расчет"
                Width="200" Height="40" HorizontalAlignment="Left" Click="btnCalculate_Click"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,15,0,0">
            <TextBlock Text="Результат: " VerticalAlignment="Center" Width="150"/>
            <TextBox x:Name="txtResult" Width="300" Height="30" IsReadOnly="True"
                     VerticalContentAlignment="Center" Background="#F0F0F0"/>
        </StackPanel>
    </Grid>
</Page>