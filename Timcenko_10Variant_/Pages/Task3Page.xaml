<Page x:Class="Timcenko_10Variant.Pages.Task3Page"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Задача 3">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap" FontSize="16" Margin="0,0,0,20">
            <Run Text="Задача 3:" FontWeight="Bold"/>
            <Run Text=" Дан целочисленный массив A размера N. Вывести номер первого из его элементов A[i], для которых A[1] &lt; A[i] &lt; A[10]. Если таких нет — вывести 0."/>
        </TextBlock>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Размер массива N (мин. 10): " VerticalAlignment="Center" Width="220"/>
            <TextBox x:Name="txtSize" Width="100" Height="30" VerticalContentAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Элементы через пробел: " VerticalAlignment="Center" Width="220"/>
            <TextBox x:Name="txtArray" Width="400" Height="30" VerticalContentAlignment="Center"/>
        </StackPanel>

        <Button Grid.Row="3" x:Name="btnCalculate" Content="Выполнить расчет"
                Width="200" Height="40" HorizontalAlignment="Left" Click="btnCalculate_Click"/>

        <StackPanel Grid.Row="4" Margin="0,15,0,0">
            <TextBlock Text="Результат (номер или 0):" Margin="0,0,0,5"/>
            <TextBox x:Name="txtResult" Height="30" IsReadOnly="True" Background="#F0F0F0"/>
        </StackPanel>
    </Grid>
</Page>